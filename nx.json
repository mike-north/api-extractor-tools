{
  "$schema": "https://nx.dev/nx.schema.json",
  "namedInputs": {
    // Bump this epoch to retire previous Nx results for every cacheable target.
    "ciCacheVersion": ["{workspaceRoot}/ci-cache-version.txt"],
    "source": ["{projectRoot}/src/**/*"],
    "tests": ["{projectRoot}/test/**/*"],
    "tsConfig": [
      "{projectRoot}/tsconfig.json",
      "{workspaceRoot}/tsconfig.json"
    ],

    "eslintConfig": ["{workspaceRoot}/eslint.config.mts"],
    "apiExtractorConfig": [
      "{projectRoot}/api-extractor.json",
      "{workspaceRoot}/api-extractor-base.json"
    ],
    "markdownConfig": ["{workspaceRoot}/.markdownlint-cli2.jsonc"],
    "markdownFiles": [
      "{workspaceRoot}/**/*.md",
      "!{workspaceRoot}/docs/**",
      "!{workspaceRoot}/api-reports/**",
      "!{workspaceRoot}/node_modules/**",
      "!{workspaceRoot}/**/node_modules/**",
      "!{workspaceRoot}/dist/**",
      "!{workspaceRoot}/**/dist/**"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build", "^build:api-artifacts"],
      "inputs": [
        "source",
        "tsConfig",
        "ciCacheVersion",
        "{projectRoot}/tsconfig.*.json",
        "{workspaceRoot}/scripts/write-esm-package.mjs"
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "test:types": {
      "dependsOn": [
        "build",
        "^build",
        "build:api-artifacts",
        "^build:api-artifacts"
      ],
      "cache": true,
      "inputs": [
        "ciCacheVersion",
        "source",
        "tsConfig",
        "{projectRoot}/test/**/*",
        "{projectRoot}/vitest.config.mts"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "build",
        "^build",
        "build:api-artifacts",
        "^build:api-artifacts"
      ],
      "cache": true,
      "inputs": [
        "ciCacheVersion",
        "source",
        "tsConfig",
        "{projectRoot}/test/**/*",
        "{projectRoot}/vitest.config.mts"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": [
        "build",
        "^build",
        "build:api-artifacts",
        "^build:api-artifacts"
      ],
      "cache": true,
      "inputs": [
        "ciCacheVersion",
        "source",
        "tsConfig",
        "{projectRoot}/test/**/*",
        "{projectRoot}/vitest.config.mts"
      ],
      "outputs": ["{projectRoot}/coverage"]
    },
    "check:eslint": {
      "cache": true,
      "inputs": ["source", "tests", "eslintConfig", "ciCacheVersion"],
      "outputs": []
    },
    "check:typecheck-tests": {
      "cache": true,
      "inputs": [
        "ciCacheVersion",
        "source",
        "tsConfig",
        "{projectRoot}/test/**/*",
        "{projectRoot}/vitest.config.mts",
        "{projectRoot}/test/tsconfig.json"
      ],
      "outputs": []
    },
    "build:api-artifacts": {
      // Rollups share dist with compilation and must be emitted after warm restores.
      "cache": false,
      "dependsOn": ["build", "^build"]
    },
    "generate:api-report": {
      // Updating the tracked baseline is an explicit developer action.
      "cache": false,
      "dependsOn": ["build:api-artifacts"]
    },
    "check:api-report": {
      // Compare the live declarations and tracked baseline on each invocation.
      "cache": false,
      "dependsOn": ["build", "^build", "^build:api-artifacts"]
    }
  }
}
