{
  "$schema": "https://nx.dev/nx.schema.json",
  "namedInputs": {
    // Bump this epoch to retire previous Nx results for every cacheable target.
    "ciCacheVersion": ["{workspaceRoot}/ci-cache-version.txt"],
    "source": ["{projectRoot}/src/**/*"],
    "tests": ["{projectRoot}/test/**/*"],
    "tsConfig": [
      "{projectRoot}/tsconfig.json",
      "{workspaceRoot}/tsconfig.json"
    ],

    "eslintConfig": ["{workspaceRoot}/eslint.config.mts"],
    "apiExtractorConfig": [
      "{projectRoot}/api-extractor.json",
      "{workspaceRoot}/api-extractor-base.json"
    ],
    "markdownConfig": ["{workspaceRoot}/.markdownlint-cli2.jsonc"],
    "markdownFiles": [
      "{workspaceRoot}/**/*.md",
      "!{workspaceRoot}/docs/**",
      "!{workspaceRoot}/api-reports/**",
      "!{workspaceRoot}/node_modules/**",
      "!{workspaceRoot}/**/node_modules/**",
      "!{workspaceRoot}/dist/**",
      "!{workspaceRoot}/**/dist/**"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build", "^generate:api-report"],
      "inputs": ["source", "tsConfig", "ciCacheVersion"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test:types": {
      "dependsOn": [
        "build",
        "^build",
        "generate:api-report",
        "^generate:api-report"
      ],
      "cache": true,
      "inputs": [
        "ciCacheVersion",
        "source",
        "tsConfig",
        "{projectRoot}/test/**/*",
        "{projectRoot}/vitest.config.mts"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "build",
        "^build",
        "generate:api-report",
        "^generate:api-report"
      ],
      "cache": true,
      "inputs": [
        "ciCacheVersion",
        "source",
        "tsConfig",
        "{projectRoot}/test/**/*",
        "{projectRoot}/vitest.config.mts"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": [
        "build",
        "^build",
        "generate:api-report",
        "^generate:api-report"
      ],
      "cache": true,
      "inputs": [
        "ciCacheVersion",
        "source",
        "tsConfig",
        "{projectRoot}/test/**/*",
        "{projectRoot}/vitest.config.mts"
      ],
      "outputs": ["{projectRoot}/coverage"]
    },
    "check:eslint": {
      "cache": true,
      "inputs": ["source", "tests", "eslintConfig", "ciCacheVersion"],
      "outputs": []
    },
    "check:typecheck-tests": {
      "cache": true,
      "inputs": [
        "ciCacheVersion",
        "source",
        "tsConfig",
        "{projectRoot}/test/**/*",
        "{projectRoot}/vitest.config.mts",
        "{projectRoot}/test/tsconfig.json"
      ],
      "outputs": []
    },
    "generate:api-report": {
      // Generation writes package rollups, shared doc models, and reports maintained in Git.
      // Execute it after clean so downstream builds receive the actual declaration rollups.
      "cache": false,
      "dependsOn": ["build", "^build"]
    },
    "check:api-report": {
      "cache": true,
      "dependsOn": ["build", "^build", "^generate:api-report"],
      "inputs": [
        "{projectRoot}/dist/**/*.d.ts",
        "apiExtractorConfig",
        "ciCacheVersion"
      ],
      "outputs": [
        "{workspaceRoot}/api-reports/{projectName}.api.md",
        "{workspaceRoot}/temp/{projectName}.api.json"
      ]
    }
  }
}
