{
  "name": "@api-extractor-tools/change-detector-core",
  "version": "0.1.1",
  "description": "Isomorphic core for detecting changes between TypeScript declaration files (browser + Node.js)",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist && node ../../scripts/clean-api-scratch.mjs change-detector-core",
    "build": "pnpm build:esm && pnpm build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node ../../scripts/mark-commonjs.mjs",
    "test": "vitest run && pnpm test:types",
    "test:types": "tsd --files 'test/**/*.test-d.ts'",
    "test:coverage": "vitest run --coverage",
    "build:api-artifacts": "node ../../scripts/run-api-extractor.mjs build",
    "generate:api-report": "node ../../scripts/run-api-extractor.mjs update",
    "check:eslint": "eslint src test",
    "check:typecheck-tests": "tsc -p test/tsconfig.json",
    "check": "pnpm check:eslint && pnpm check:typecheck-tests && pnpm check:api-report",
    "check:api-report": "node ../../scripts/run-api-extractor.mjs check"
  },
  "keywords": [
    "typescript",
    "api",
    "semver",
    "change-detection",
    "isomorphic"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@microsoft/tsdoc": "^0.16.0",
    "@typescript-eslint/typescript-estree": "^8.49.0",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.55.2",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "^4.0.15",
    "pkg-up": "^4.0.0",
    "tsd": "^0.33.0",
    "vitest": "^4.0.15",
    "zod": "^4.1.13"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./ast": {
      "import": {
        "types": "./dist/esm/ast/index.d.ts",
        "default": "./dist/esm/ast/index.js"
      },
      "require": {
        "types": "./dist/cjs/ast/index.d.ts",
        "default": "./dist/cjs/ast/index.js"
      }
    },
    "./rules": {
      "import": {
        "types": "./dist/esm/rules.d.ts",
        "default": "./dist/esm/rules.js"
      },
      "require": {
        "types": "./dist/cjs/rules.d.ts",
        "default": "./dist/cjs/rules.js"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/esm/plugins.d.ts",
        "default": "./dist/esm/plugins.js"
      },
      "require": {
        "types": "./dist/cjs/plugins.d.ts",
        "default": "./dist/cjs/plugins.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "ast": [
        "./dist/esm/ast/index.d.ts"
      ],
      "rules": [
        "./dist/esm/rules.d.ts"
      ],
      "plugins": [
        "./dist/esm/plugins.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ]
}
