{
  "name": "@api-extractor-tools/input-processor-typescript",
  "version": "0.1.0",
  "description": "TypeScript input processor plugin for change-detector",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node scripts/inject-version.mjs && pnpm build:esm && pnpm build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node ../../scripts/mark-commonjs.mjs",
    "test": "vitest run && pnpm test:types",
    "test:types": "tsd --files 'test/**/*.test-d.ts'",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm check:eslint && pnpm check:typecheck-tests",
    "check:eslint": "eslint src test",
    "check:typecheck-tests": "tsc -p test/tsconfig.json"
  },
  "keywords": [
    "typescript",
    "api",
    "change-detection",
    "plugin",
    "change-detector:plugin",
    "change-detector:input-processor-plugin"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@api-extractor-tools/change-detector-core": "workspace:*",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@vitest/coverage-v8": "^4.0.15",
    "tsd": "^0.33.0",
    "vitest": "^4.0.15"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ]
}
